 import numpy as np
@@ -460,3 +461,56 @@ def test_successful_submit_preserves_reservation_with_success_record(
     assert result["job_id"] == "123"
     assert (workdir / submission.SUBMISSION_ATTEMPT_FILE).is_file()
     assert (workdir / submission.SUBMISSION_RECORD_FILE).is_file()
+
+
+@pytest.mark.parametrize("directive", [
+    "#BSUB -R", "#BSUB -R ''", "#BSUB -q queue",
+    "#BSUB -R 'unterminated", "#BSUB -R a\n#BSUB -R b",
+])
+def test_invalid_resource_directive_fails_preflight(tmp_path, directive):
+    _common(tmp_path, "NSW=0\nIBRION=-1\n", 80)
+    (tmp_path / "POSCAR").write_text("test structure", encoding="utf-8")
+    (tmp_path / "script.lsf").write_text("NP=80\n" + directive, encoding="utf-8")
+    report = preflight(tmp_path, "diagnostic_static")
+    assert not report["passed"]
+    assert any(error.startswith("invalid_lsf_directive:") for error in report["errors"])
+
+
+def test_bound_resource_requirement_reaches_bsub(tmp_path, monkeypatch):
+    from scripts.artifact_io import load_json_object, write_json
+    from tests.test_execution_lifecycle import authorize_evidence, launch
+
+    workdir, decision_path, _ = prepare_submission(tmp_path, monkeypatch)
+    requirement = 'select[hname!="gknew0440"]'
+    (workdir / "script.lsf").write_text(
+        "NP=1\n#BSUB -R " + shlex.quote(requirement) + "\n", encoding="utf-8",
+    )
+    report = submission.preflight(workdir, "diagnostic_static")
+    assert report["passed"] and report["resource_requirement"] == requirement
+    evidence = load_json_object(decision_path)["EVIDENCE"]
+    evidence["preflight"] = report
+    evidence["source_bindings"]["preflight"]["sha256"] = sha256_file(
+        workdir / "submission_preflight.json",
+    )
+    write_json(decision_path, authorize_evidence(workdir, evidence))
+    commands = []
+
+    def fake_run(argv):
+        commands.append(argv[-1])
+        return type("Result", (), {"stdout": "Job <123> is submitted"})()
+
+    monkeypatch.setattr(submission, "_run", fake_run)
+    monkeypatch.setattr(submission, "_upload_manifest_files", lambda *args: None)
+    assert launch(workdir, decision_path)["job_id"] == "123"
+    assert submission._bsub_command(report) in shlex.split(commands[-1])[2]
+    assert shlex.split(submission._bsub_command(report)) == [
+        "bsub", "-R", requirement, "script.lsf",
+    ]
+
+
+def test_bsub_resource_is_single_shell_argument():
+    requirement = 'select[hname!="x"]; $(touch forbidden)'
+    assert shlex.split(submission._bsub_command({"resource_requirement": requirement})) == [
+        "bsub", "-R", requirement, "script.lsf",
+    ]
+    assert submission._bsub_command({}) == "bsub script.lsf"
