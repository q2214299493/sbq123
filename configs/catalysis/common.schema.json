        ]
      },
      "additionalProperties": {"type": "integer", "minimum": 1},
      "minProperties": 1
    },
    "sites": {
      "type": "object",
      "propertyNames": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/id"},
      "additionalProperties": {"type": "integer", "minimum": 1},
      "minProperties": 0
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "reference_id", "source"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"const": "eV"},
        "reference_id": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/id"},
        "source": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/evidence"}
      }
    },
    "energy_triple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction", "forward", "reverse"],
      "properties": {
        "reaction": {
          "anyOf": [
            {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/energy"},
            {"type": "null"}
          ]
        },
        "forward": {
          "anyOf": [
            {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/energy"},
            {"type": "null"}
          ]
        },
        "reverse": {
          "anyOf": [
            {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/energy"},
            {"type": "null"}
          ]
        }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefactor", "prefactor_unit", "temperature_exponent", "activation_energy", "expression"],
      "properties": {
        "prefactor": {"type": "number", "exclusiveMinimum": 0},
        "prefactor_unit": {
          "description": "Per-site rates with dimensionless activities, or explicit pressure/concentration factors.",
          "enum": ["s^-1", "Pa^-1 s^-1", "Pa^-2 s^-1", "m^3 mol^-1 s^-1", "m^6 mol^-2 s^-1"]
        },
        "temperature_exponent": {"type": "number"},
        "activation_energy": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/energy"},
        "expression": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/text"}
      }
    }
  }
}
