+++ b/scripts/baseline_mkm/result_binding.py
@@ -0,0 +1,55 @@
+"""Read-only binding of an accepted CATKINAS point and its observed steady-state solution."""
+
+import argparse
+import json
+from pathlib import Path
+
+from scripts.artifact_io import sha256_file, sha256_json
+from scripts.baseline_mkm.steady_states import observe
+from scripts.kinetic_data.scientific_identity import check_binding, dataset_reference, read_artifact
+from scripts.multiphase_contracts import read_unique_json as read
+
+
+def bind_result(run, *, normalization_profile=None):
+    run = Path(run)
+    plan = read(run / "plan.json")
+    dataset, dataset_hash = read_artifact(run / "dataset.json")
+    inputs = dict(network=sha256_file(run / "network.json"), dataset=dataset_hash,
+                  configuration=sha256_file(run / "configuration.json"))
+    if inputs != plan["input_hashes"] or dataset["network_version"] != plan["network_version_id"]:
+        raise ValueError("MKM network, dataset or configuration differs from approved plan")
+    approved_profile = plan.get("normalization_profile_sha256")
+    profile = normalization_profile or plan.get("normalization_profile")
+    profile_hash = sha256_file(Path(profile)) if profile else None
+    if approved_profile and profile_hash != approved_profile:
+        raise ValueError("MKM normalization profile differs from approved plan")
+    point = observe(run, Path(profile) if profile else None)
+    result = read(run / "result.json")
+    if (result["run_id"] != plan["run_id"] or point["plan_sha256"] != result["plan_sha256"]
+            or point["result_sha256"] != sha256_file(run / "result.json")
+            or dataset["dataset_version"] != plan["kinetic_dataset_version"]):
+        raise ValueError("MKM result identity differs from accepted execution")
+    root = {k: point[k] for k in ("coverage", "vacancy", "native_initial", "initial_coverages",
+                                  "single_point_residual", "analysis_residual")}
+    evidence = {k: point[k] for k in ("plan_sha256", "receipt_sha256", "result_sha256", "native_input_sha256",
+                                      "mat_sha256", "log_sha256", "runtime")}
+    payload = dict(format="mkm-point-binding/1", run_id=plan["run_id"], scope=result["scope"],
+                   dataset=dataset_reference(dataset, dataset_hash), input_hashes=inputs,
+                   conditions={k: plan[k] for k in ("temperature_K", "total_pressure_bar",
+                                                      "partial_pressures_bar", "standard_states")},
+                   execution=evidence, normalization=point["normalization"], net_rate_unit=point["net_rate_unit"],
+                   normalization_profile_sha256=profile_hash, profile_bound_by_plan=bool(approved_profile),
+                   root=root, root_state_sha256=sha256_json({k: root[k] for k in ("coverage", "vacancy")}))
+    return dict(payload, binding_sha256=sha256_json(payload))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("run", type=Path)
+    parser.add_argument("--verify", type=Path)
+    parser.add_argument("--normalization-profile", type=Path, help="Reviewed profile for legacy points")
+    args = parser.parse_args()
+    binding = bind_result(args.run, normalization_profile=args.normalization_profile)
+    if args.verify:
+        check_binding(read(args.verify), binding)
+    print(json.dumps(binding, indent=2, allow_nan=False))
diff --git a/tests/test_scientific_identity.py b/tests/test_scientific_identity.py
new file mode 100644
--- /dev/null
+++ b/tests/test_scientific_identity.py
@@ -0,0 +1,106 @@
+"""Synthetic kinetic datasets and the existing dissociative ads benchmark."""
+
+from copy import deepcopy
+import json
+from pathlib import Path
+
+import pytest
+
+from scripts.artifact_io import sha256_json
+from scripts.kinetic_data.scientific_identity import dataset_reference, read_artifact, require_reaction_identity
+from test_native_model import model
+
+
+def version(dataset):
+    dataset["dataset_version"] = sha256_json({k: v for k, v in dataset.items() if k != "dataset_version"})
+    return dataset
+
+
+def test_identity_uses_species_definitions_and_ignores_native_order():
+    left, _ = model(gas=True)
+    right = deepcopy(left)
+    right["species"].reverse()
+    for values in right["catalog"].values():
+        values.reverse()
+    rid = left["reactions"][0]["reaction_id"]
+    identity = require_reaction_identity(left, version(right), rid)
+    assert sum(identity["molecular_stoichiometry"]["products"].values()) == 1
+    assert identity["per_event_sites"]["sites_consumed"] == {"top-Ni": 1, "bridge-Cu": 1}
+
+
+def test_reviewed_ads_same_site_demand_different_molecular_products():
+    root = Path(__file__).resolve().parents[1]
+    mkm, _ = read_artifact(root / "archive/v221_catkinas/nicu-v221-400k-001/dataset.json")
+    kmc, _ = model(gas=True)
+    r = kmc["reactions"][0]
+    assert r["reaction_id"] == "ads"
+    a = next(row for row in mkm["reactions"] if row["reaction_id"] == "ads")
+    assert a["direction"]["forward"]["sites_consumed"] == r["direction"]["forward"]["sites_consumed"]
+    with pytest.raises(ValueError, match="molecular_stoichiometry") as exc:
+        require_reaction_identity(mkm, version(kmc), "ads")
+    assert "per_event_sites" not in str(exc.value)
+
+
+@pytest.mark.parametrize("mutation,reason", [
+    ("bytes", "digest"), ("direction", "direction"), ("gross", "inventory"),
+    ("owner", "inventory_owners"), ("vacancy", "per_event_sites"), ("unknown", "Unknown reaction"),
+])
+def test_incompatible_or_stale_identity(mutation, reason):
+    a, _ = model(gas=True)
+    b = json.loads(json.dumps(a))  # Independent forward/reverse mappings as stored on disk.
+    r = b["reactions"][0]
+    rid = r["reaction_id"]
+    if mutation == "direction":
+        r["direction"]["reverse"] = None
+    elif mutation == "gross":
+        r["site_balance"]["top-Ni"] += 1
+    elif mutation == "owner":
+        b["catalog"]["sites"][0]["local_geometry"] += " altered"
+    elif mutation == "vacancy":
+        for sense, side in (("forward", "sites_consumed"), ("forward", "sites_released"),
+                            ("reverse", "sites_consumed"), ("reverse", "sites_released")):
+            counts = r["direction"][sense][side]
+            counts["top-Ni"] = counts.get("top-Ni", 0) + 1
+        r["site_balance"]["top-Ni"] += 1
+        local = r["model"]["local_event"]
+        local["site_ids"].append("top-Ni")
+        for key in ("initial", "final"):
+            local[key].append(None)
+        local["neighbors_zero_based"].append([1, 2])
+    elif mutation == "unknown":
+        rid = "missing"
+    version(b)
+    if mutation == "bytes":
+        b["project_id"] += "x"
+    with pytest.raises(ValueError, match=reason):
+        require_reaction_identity(a, b, rid)
+
+
+def test_parameter_content_retains_reference_uncertainty_and_units():
+    a, _ = model(gas=True)
+    b = deepcopy(a)
+    r = b["reactions"][0]
+    r["parameter_set"]["energy_reference_id"] += "-different"
+    r["parameter_set"]["uncertainty"] = {"kind": "test-only"}
+    r["rates"]["forward"]["sigma_ln_k"] = 0.25
+    version(b)
+    rid = r["reaction_id"]
+    assert require_reaction_identity(a, b, rid)
+    old, new = (dataset_reference(d, "0" * 64)["parameters"][rid] for d in (a, b))
+    assert new["parameter_set_id"] == old["parameter_set_id"]
+    assert new["reaction_row_sha256"] != old["reaction_row_sha256"]
+    assert new["uncertainty"] == r["parameter_set"]["uncertainty"]
+    assert new["energy_reference_id"] == r["parameter_set"]["energy_reference_id"]
+
+def test_missing_local_pattern_or_changed_spectator():
+    left, _ = model(gas=True)
+    right = deepcopy(left)
+    row = right["reactions"][0]
+    rid = row["reaction_id"]
+    local = row["model"].pop("local_event")
+    with pytest.raises(ValueError, match="local site pattern"):
+        require_reaction_identity(left, version(right), rid)
+    row["model"]["local_event"] = local
+    local["environment"] = dict(site_ids=["top-Ni"], state=[None], neighbors_zero_based=[[1, 2]])
+    with pytest.raises(ValueError, match="local_geometry"):
+        require_reaction_identity(left, version(right), rid)
diff --git a/tests/test_mkm_result_binding.py b/tests/test_mkm_result_binding.py
new file mode 100644
--- /dev/null
+++ b/tests/test_mkm_result_binding.py
@@ -0,0 +1,53 @@
+"""Accepted point fixtures use a mocked CATKINAS launcher and replayed MAT data."""
+
+from copy import deepcopy
+
+from pathlib import Path
+
+import pytest
+
+from scripts.artifact_io import sha256_file
+from scripts.baseline_mkm.result_binding import bind_result
+from scripts.kinetic_data.scientific_identity import check_binding
+from test_mkm_single_point import runtime  # noqa: F401
+from test_mkm_steady_states import PROFILE, accept, pair  # noqa: F401
+
+
+def test_observed_root_conditions_and_execution(pair):  # noqa: F811
+    path, _ = pair
+    points = []
+    for name in ("point-001", "point-002"):
+        assert accept(path, name) == "ACCEPTED"
+        run = path.parent / name
+        result = bind_result(run)
+        assert result["execution"]["result_sha256"] == sha256_file(run / "result.json")
+        assert result["execution"]["receipt_sha256"] == sha256_file(run / "ACCEPTED.json")
+        assert result["conditions"]["temperature_K"] == 400
+        points.append(result)
+    a, b = points
+    assert a["root"]["native_initial"] != b["root"]["native_initial"]
+    assert a["root_state_sha256"] == b["root_state_sha256"]
+    assert a["binding_sha256"] != b["binding_sha256"]
+    check_binding(a, bind_result(path.parent / "point-001"))
+    for key in ("conditions", "root", "execution"):
+        forged = deepcopy(a)
+        forged[key] = {}
+        with pytest.raises(ValueError, match="reconstructed"):
+            check_binding(forged, a)
+
+
+def test_changed_input_bytes_fail_even_with_same_json(pair):  # noqa: F811
+    path, _ = pair
+    assert accept(path, "point-001") == "ACCEPTED"
+    run = path.parent / "point-001"
+    with (run / "configuration.json").open("ab") as stream:
+        stream.write(b" ")
+    with pytest.raises(ValueError, match="approved plan"):
+        bind_result(run)
+
+def test_legacy_profile_is_separately_attributed():
+    run = Path(__file__).resolve().parents[1] / "archive/v221_catkinas/nicu-v221-400k-001"
+    binding = bind_result(run, normalization_profile=PROFILE)
+    assert binding["profile_bound_by_plan"] is False
+    assert binding["normalization_profile_sha256"] == sha256_file(PROFILE)
+    assert binding["execution"]["result_sha256"] == sha256_file(run / "result.json")
