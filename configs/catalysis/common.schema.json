{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json",
  "title": "common v1.0.0",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "not": {"pattern": "\\s"}},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/text"},
        "sha256": {"type": "string", "maxLength": 64, "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calculation_id", "kind", "artifact"],
      "properties": {
        "calculation_id": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/id"},
        "kind": {
          "enum": ["electronic_structure", "thermal_correction", "experiment", "model_prediction", "synthetic"]
        },
        "artifact": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/artifact"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review"],
      "properties": {
        "status": {"enum": ["unreviewed", "in_review", "accepted", "rejected"]},
        "review": {
          "anyOf": [
            {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/artifact"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "accepted"}}
          },
          "then": {
            "properties": {
              "review": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/artifact"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "rejected"}}
          },
          "then": {
            "properties": {
              "review": {"$ref": "https://schemas.sbq123.invalid/multiphase/1.0.0/common.schema.json#/$defs/artifact"}
            }
          }
        }
      ]
    },
    "composition": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "H",
          "He",
          "Li",
          "Be",
          "B",
          "C",
          "N",
          "O",
          "F",
          "Ne",
          "Na",
