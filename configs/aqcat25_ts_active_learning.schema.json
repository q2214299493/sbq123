{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/aqcat25-ts-active-learning.schema.json",
  "title": "AQCat25 TS active-learning evidence documents",
  "oneOf": [
    { "$ref": "#/$defs/state" },
    { "$ref": "#/$defs/schedulerEvidence" },
    { "$ref": "#/$defs/predictionRequest" },
    { "$ref": "#/$defs/forcePrediction" },
    { "$ref": "#/$defs/vaspForceLabel" },
    { "$ref": "#/$defs/independentValidationSet" },
    { "$ref": "#/$defs/domainAssessment" },
    { "$ref": "#/$defs/calibrationReview" },
    { "$ref": "#/$defs/calibrationReuseContext" },
    { "$ref": "#/$defs/trainingManifest" },
    { "$ref": "#/$defs/finetuneResult" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonempty": { "type": "string", "minLength": 1 },
    "checkpoint": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonempty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "forceVector": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "forceMatrix": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/forceVector" }
    },
    "fileRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonempty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "required": [
        "schema_version", "document_kind", "workflow_kind", "reaction_id",
        "contract_sha256", "atom_map_sha256", "compatibility_sha256",
        "policy_path", "policy_sha256", "status", "next_action", "rounds",
        "data_policy", "created_at", "updated_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_active_learning_state" },
        "workflow_kind": { "const": "aqcat25_ts_sequential_active_learning" },
        "reaction_id": { "$ref": "#/$defs/nonempty" },
        "contract_sha256": { "$ref": "#/$defs/sha256" },
        "atom_map_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_sha256": { "$ref": "#/$defs/sha256" },
        "policy_path": { "$ref": "#/$defs/nonempty" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/nonempty" },
        "next_action": { "$ref": "#/$defs/nonempty" },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["round_index", "status", "candidate", "job_evidence"],
            "properties": {
              "round_index": { "type": "integer", "minimum": 0 },
              "status": { "$ref": "#/$defs/nonempty" },
              "candidate": { "type": "object" },
              "job_evidence": { "type": "object" }
            },
            "additionalProperties": true
          }
        },
        "data_policy": { "type": "object" },
        "latest_finetuned_checkpoint": { "$ref": "#/$defs/checkpoint" },
        "ts_domain_calibration": { "type": "object" },
        "failures": { "type": "array", "items": { "type": "object" } },
        "resume_status": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/nonempty" },
        "updated_at": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    },
    "schedulerEvidence": {
      "type": "object",
      "required": [
        "schema_version", "document_kind", "stage", "scheduler", "server_alias",
        "job_id", "status", "checked_at", "source_command", "query"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "scheduler_job_evidence" },
        "stage": { "enum": ["vasp_force_label", "force_prediction", "force_only_finetuning", "ba_sella_rerun", "neb_pilot", "ordinary_neb", "diagnostic_static", "dimer", "vfa"] },
        "scheduler": { "enum": ["LSF", "Slurm"] },
        "server_alias": { "enum": ["sunboquan-codex", "MZ73"] },
        "job_id": { "$ref": "#/$defs/nonempty" },
        "status": { "enum": ["SUBMITTED", "PEND", "RUN", "DONE", "EXIT", "FAILED", "COMPLETED"] },
        "checked_at": { "$ref": "#/$defs/nonempty" },
        "source_command": { "$ref": "#/$defs/nonempty" },
        "query": {
          "type": "object",
          "required": ["argv", "returncode", "stdout", "stderr", "stdout_sha256"],
          "properties": {
            "argv": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nonempty" } },
            "returncode": { "const": 0 },
            "stdout": { "$ref": "#/$defs/nonempty" },
            "stderr": { "type": "string" },
            "stdout_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "predictionRequest": {
      "type": "object",
      "required": ["schema_version", "document_kind", "reaction_id", "round_index", "structure", "checkpoint", "indexed_bond_changes", "adsorbate_indices_1based", "result_class", "restrictions"],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_force_prediction_request" },
        "reaction_id": { "$ref": "#/$defs/nonempty" },
        "round_index": { "type": "integer", "minimum": 0 },
        "structure": {
          "type": "object",
          "required": ["path", "sha256", "atom_order_sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/nonempty" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "atom_order_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "indexed_bond_changes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "adsorbate_indices_1based": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "result_class": { "const": "predicted_transition_state_candidate_only" },
        "restrictions": {
          "type": "object",
          "required": ["backend", "reportable_dft", "automatic_submission"],
          "properties": {
            "backend": { "const": "MZ73" },
            "reportable_dft": { "const": false },
            "automatic_submission": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "forcePrediction": {
      "type": "object",
      "required": ["schema_version", "document_kind", "request_sha256", "structure_sha256", "checkpoint_sha256", "predicted_energy_eV", "forces_eV_per_A", "result_class", "reportable_dft", "scientifically_validated_ts"],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_force_prediction" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "structure_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "predicted_energy_eV": { "type": "number" },
        "forces_eV_per_A": { "$ref": "#/$defs/forceMatrix" },
        "result_class": { "const": "predicted_transition_state_candidate_only" },
        "reportable_dft": { "const": false },
        "scientifically_validated_ts": { "const": false }
      },
      "additionalProperties": false
    },
    "vaspForceLabel": {
      "type": "object",
      "required": [
        "schema_version", "document_kind", "reaction_id", "round_index",
        "contract_sha256", "compatibility_sha256", "result_class",
        "reportable_final_energy", "eligible_for_force_only_training",
        "scheduler_evidence", "label_request", "structure",
        "fixed_atom_indices_zero_based", "outcar", "oszicar",
        "normal_completion", "electronically_converged", "electronic_convergence_source", "last_electronic_iteration",
        "last_delta_e_eV", "ediff_eV", "nelm", "dft_toten_eV_force_label_only",
        "forces_eV_per_A"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "vasp_ts_force_label" },
        "reaction_id": { "$ref": "#/$defs/nonempty" },
        "round_index": { "type": "integer", "minimum": 0 },
        "contract_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_sha256": { "$ref": "#/$defs/sha256" },
        "result_class": { "const": "vasp_completed_electronic_converged_force_label_only" },
        "reportable_final_energy": { "const": false },
        "eligible_for_force_only_training": { "const": true },
        "scheduler_evidence": { "type": "object" },
        "label_request": { "$ref": "#/$defs/fileRef" },
        "structure": { "$ref": "#/$defs/fileRef" },
        "fixed_atom_indices_zero_based": {
          "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true
        },
        "outcar": { "$ref": "#/$defs/fileRef" },
        "oszicar": { "$ref": "#/$defs/fileRef" },
        "normal_completion": { "const": true },
        "electronically_converged": { "const": true },
        "electronic_convergence_source": {
          "enum": ["OUTCAR_EDIFF_TERMINATION", "OSZICAR_DELTA_E"]
        },
        "last_electronic_iteration": { "type": "integer", "minimum": 1 },
        "last_delta_e_eV": { "type": "number" },
        "ediff_eV": { "type": "number", "exclusiveMinimum": 0 },
        "nelm": { "type": "integer", "minimum": 1 },
        "dft_toten_eV_force_label_only": { "type": "number" },
        "forces_eV_per_A": { "$ref": "#/$defs/forceMatrix" }
      },
      "additionalProperties": false
    },
    "independentValidationSet": {
      "type": "object",
      "required": [
        "schema_version", "document_kind", "checkpoint_sha256",
        "compatibility_sha256", "samples"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_independent_validation_set" },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_sha256": { "$ref": "#/$defs/sha256" },
        "samples": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["sample_id", "role", "label", "label_sha256", "prediction", "prediction_sha256"],
            "properties": {
              "sample_id": { "$ref": "#/$defs/nonempty" },
              "role": { "enum": ["rising_path", "near_saddle", "falling_path"] },
              "label": { "$ref": "#/$defs/nonempty" },
              "label_sha256": { "$ref": "#/$defs/sha256" },
              "prediction": { "$ref": "#/$defs/nonempty" },
              "prediction_sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "domainAssessment": {
      "type": "object",
      "required": [
        "schema_version", "document_kind", "status", "calibration_id",
        "gate_path", "gate_sha256", "checkpoint_sha256", "metrics",
        "thresholds", "checks", "missing_roles", "independence", "samples",
        "ts_domain_validated", "active_learning_converged",
        "scientifically_validated_ts", "reportable_final_energy"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_domain_assessment" },
        "status": { "enum": ["passed", "failed", "bootstrap_passed"] },
        "calibration_id": { "$ref": "#/$defs/nonempty" },
        "gate_path": { "$ref": "#/$defs/nonempty" },
        "gate_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "metrics": { "type": "object" },
        "thresholds": { "type": "object" },
        "checks": { "type": "object" },
        "missing_roles": { "type": "array", "items": { "type": "string" } },
        "independence": { "type": "object" },
        "samples": { "type": "array", "minItems": 5, "items": { "type": "object" } },
        "ts_domain_validated": { "type": "boolean" },
        "active_learning_converged": { "type": "boolean" },
        "scientifically_validated_ts": { "const": false },
        "reportable_final_energy": { "const": false }
      },
      "additionalProperties": false
    },
    "calibrationReview": {
      "type": "object",
      "required": [
        "schema_version", "document_kind", "assessment_sha256",
        "checkpoint_sha256", "compatibility_sha256", "reaction_domain",
        "force_acceptance", "reviewer", "reviewed_at", "status"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_domain_calibration_review" },
        "assessment_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_sha256": { "$ref": "#/$defs/sha256" },
        "reaction_domain": { "$ref": "#/$defs/nonempty" },
        "force_acceptance": {
          "type": "object",
          "required": [
            "component_mae_eV_per_A_max", "vector_rmse_eV_per_A_max",
            "vector_p95_eV_per_A_max", "vector_max_eV_per_A_max"
          ],
          "additionalProperties": false,
          "properties": {
            "component_mae_eV_per_A_max": { "type": "number", "exclusiveMinimum": 0 },
            "vector_rmse_eV_per_A_max": { "type": "number", "exclusiveMinimum": 0 },
            "vector_p95_eV_per_A_max": { "type": "number", "exclusiveMinimum": 0 },
            "vector_max_eV_per_A_max": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "reviewer": { "$ref": "#/$defs/nonempty" },
        "reviewed_at": { "$ref": "#/$defs/nonempty" },
        "status": { "const": "accepted" }
      },
      "additionalProperties": false
    },
    "calibrationReuseContext": {
      "type": "object",
      "required": [
        "schema_version", "document_kind", "checkpoint_sha256",
        "compatibility_sha256", "reaction_domain", "reaction_domain_in_scope",
        "novelty_or_uncertainty_gate_passed", "periodic_audit_due",
        "reviewer", "reviewed_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_domain_reuse_context" },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_sha256": { "$ref": "#/$defs/sha256" },
        "reaction_domain": { "$ref": "#/$defs/nonempty" },
        "reaction_domain_in_scope": { "type": "boolean" },
        "novelty_or_uncertainty_gate_passed": { "type": "boolean" },
        "periodic_audit_due": { "type": "boolean" },
        "reviewer": { "$ref": "#/$defs/nonempty" },
        "reviewed_at": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    },
    "trainingManifest": {
      "type": "object",
      "required": ["schema_version", "document_kind", "reaction_id", "round_index", "base_checkpoint", "labels", "training_samples", "validation_samples", "replay_evidence", "epochs", "output_result_class", "training_target", "energy_loss_coefficient", "checkpoint_acceptance_requires", "restrictions"],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_force_only_training_manifest" },
        "reaction_id": { "$ref": "#/$defs/nonempty" },
        "round_index": { "type": "integer", "minimum": 0 },
        "base_checkpoint": { "$ref": "#/$defs/checkpoint" },
        "labels": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["structure_path", "structure_sha256", "forces_eV_per_A", "source_result_class"] } },
        "training_samples": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["sample_id", "sample_role", "structure_path", "structure_sha256", "forces_eV_per_A"] } },
        "validation_samples": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["sample_id", "sample_role", "structure_path", "structure_sha256", "forces_eV_per_A"] } },
        "replay_evidence": { "type": "object", "required": ["labels_sha256", "training_sample_count", "validation_sample_count", "validation_sample_ids", "thresholds_path", "thresholds_sha256"] },
        "epochs": { "type": "integer", "minimum": 1 },
        "output_result_class": { "const": "force_only_finetuned_checkpoint_candidate" },
        "training_target": { "const": "forces_only" },
        "energy_loss_coefficient": { "const": 0.0 },
        "checkpoint_acceptance_requires": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/nonempty" }, "uniqueItems": true },
        "restrictions": {
          "type": "object",
          "required": ["remote_write_root", "reportable_final_energy", "scientific_acceptance"],
          "properties": {
            "remote_write_root": { "pattern": "^/home/sbq/sbq(?:/|$)" },
            "reportable_final_energy": { "const": false },
            "scientific_acceptance": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "finetuneResult": {
      "type": "object",
      "required": ["schema_version", "document_kind", "status", "result_class", "hostname", "gpu_job_id", "training_manifest_sha256", "base_checkpoint_sha256", "checkpoint", "checkpoint_validation", "producer_exit_record", "reportable_final_energy", "scientific_acceptance"],
      "properties": {
        "schema_version": { "const": 1 },
        "document_kind": { "const": "aqcat25_ts_force_only_finetune_result" },
        "status": { "const": "success" },
        "result_class": { "const": "force_only_finetuned_checkpoint_candidate" },
        "hostname": { "const": "MZ73" },
        "gpu_job_id": { "$ref": "#/$defs/nonempty" },
        "training_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "base_checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "checkpoint_validation": { "type": "object", "required": ["path", "sha256", "status", "checkpoint_sha256", "metrics", "scope"] },
        "producer_exit_record": { "type": "object", "required": ["path", "sha256"] },
        "reportable_final_energy": { "const": false },
        "scientific_acceptance": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
